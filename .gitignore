# ruflo / claude-flow agent tooling — machine-local generated state.
# Skill dumps, daemon pid/metrics, and the swarm memory DB (binary) churn on
# every session and are regenerated by `ruflo init`; they are not project source.
.agents/
.claude-flow/
.swarm/

# Generated agent/skill definitions under .claude. The hand-maintained
# settings and speckit commands stay tracked.
.claude/agents/
.claude/helpers/
.claude/skills/
.claude/commands/*
!.claude/commands/speckit.*.md
.claude/proven-config.json
.claude/.proven-config-version
