# Copy to .env and fill in real values. Never commit .env with secrets.

# Required: Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SECURITY: never set VITE_SUPABASE_SERVICE_ROLE_KEY — any VITE_* var ships in the
# client bundle and the service role bypasses all RLS. Admin operations go
# through the admin-users Edge Function instead.

# Declared in vite-env.d.ts — set if your admin app reads them
# VITE_API_URL=https://api.example.com
# VITE_APP_TITLE=POS Admin

# Public base URL (mirrors store-app pattern in vite.config)
# VITE_PUBLIC_URL=http://localhost:5179
